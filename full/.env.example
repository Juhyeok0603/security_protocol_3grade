# Optional. Browser API base path. Keep /api for the integrated Next.js app.
NEXT_PUBLIC_API_BASE_PATH=/api

# Optional. Local server-side data directory.
# On Vercel, the default is /tmp/protocol-final and data is not permanent.
# PROTOCOL_DATA_DIR=.data

# Optional. Persistent Redis storage for deployed/serverless environments.
# Upstash usually provides UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN.
# Older Vercel KV setups may provide KV_REST_API_URL and KV_REST_API_TOKEN.
# PROTOCOL_REDIS_STORE_KEY=protocol-final:store
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
